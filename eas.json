{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}",
        "UPI_ID": "${UPI_ID}",
        "PAYEE_NAME": "${PAYEE_NAME}",
        "PAYMENT_AMOUNT": "${PAYMENT_AMOUNT}"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}",
        "UPI_ID": "${UPI_ID}",
        "PAYEE_NAME": "${PAYEE_NAME}",
        "PAYMENT_AMOUNT": "${PAYMENT_AMOUNT}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
